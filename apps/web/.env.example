# Firebase 웹 설정 (백엔드 담당이 값 공유). 실제 값은 .env.local에 넣고 커밋하지 않는다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 블록 익스플로러와 컨트랙트 주소 (기본 Polygon Amoy). 컨트랙트 주소는 contracts/deployments/amoy.json
VITE_CHAIN_EXPLORER=https://amoy.polygonscan.com
VITE_CHAIN_CONTRACT=
# App Check (reCAPTCHA Enterprise 사이트 키). 비워 두면 App Check를 켜지 않는다
VITE_APPCHECK_SITE_KEY=
# 개발용 App Check 디버그 토큰 (dev 서버에서만 쓰고 커밋하지 않는다)
VITE_APPCHECK_DEBUG_TOKEN=
