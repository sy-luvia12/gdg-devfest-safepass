rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() == 'admin');
    }
    match /tickets/{ticketId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || role() == 'admin');
    }
    // 학교 이름·상징색·메일 도메인. 로그인한 사람은 누구나 읽는다
    match /schools/{schoolId} {
      allow read: if signedIn();
    }
    match /events/{eventId} {
      allow read: if signedIn();
      // 대기 명단(waitlist)은 문서 id가 학생 메일이라 클라이언트가 읽지 못한다. 행사 담당자는 getWaitlist(이름·학번만)로 본다
      // 행사 명단: 학생은 자기 학번 줄 하나만 읽는다 (목록의 "명단에 없음" 표시). 목록 조회(list)는 막는다
      match /roster/{studentId} {
        allow get: if signedIn() && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.studentId == studentId;
      }
    }
    // 스태프는 자기가 검표한 기록만 ("내 검표 기록"). 쿼리에 where('staffUid', '==', uid)가 있어야 한다
    match /scanLogs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.staffUid == request.auth.uid);
    }
    // 기기 초기화 요청: 관리자는 전체, 학생은 자기 요청만
    match /deviceResets/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }
    // schools/{id}/roster(재학생 명단)는 match가 없어서 클라이언트가 읽을 수 없다. 행사 명단은 자기 줄만. 대조와 조회는 함수만 한다
    // qrTokens, devices는 match가 없어서 클라이언트가 읽을 수 없다. QR 토큰은 함수만 다룬다
    match /reassignments/{id} {
      allow read: if isAdmin();
    }
    match /{document=**} {
      allow write: if false;   // 쓰기는 함수(Admin SDK)만
    }
  }
}
